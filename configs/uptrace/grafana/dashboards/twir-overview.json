    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "uptrace-clickhouse" },
      "description": "Application p95 from OTel spans. One view combines command parsing, EventSub delivery, and the most useful bot message handlers.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "p95",
            "axisPlacement": "auto", "barAlignment": 0, "barWidthFactor": 0.6, "drawStyle": "line",
            "fillOpacity": 18, "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 4,
            "scaleDistribution": { "type": "log", "log": 2 }, "showPoints": "never", "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true, "width": 390 },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "uptrace-clickhouse" },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT bucket AS time, operation, quantileTDigestWeighted(0.95)(duration, count_x100) AS p95 FROM (SELECT toStartOfInterval(time, INTERVAL $__interval_s SECOND) AS bucket, count_x100, duration, multiIf(service_name = 'parser' AND system = 'messaging:nats' AND name = 'Read parser.process_message_as_command', 'Command · total', service_name = 'eventsub' AND system = 'funcs' AND name IN ('eventsub.websocket.handler', 'HandleChannelChatMessage'), 'EventSub · pipeline', service_name = 'bots' AND system = 'funcs' AND name = 'handle', 'Bot · message', service_name = 'bots' AND system = 'funcs' AND name = 'handleTts', 'Bot · TTS', service_name = 'bots' AND system = 'funcs' AND name IN ('handleModeration', 'handleGiveaways', 'handleKeywords', 'handleChatWall', 'handleGreetings', 'handleEmotesUsages', 'handleRemoveLurker', 'handleFirstStreamUserJoin'), 'Bot · features', '') AS operation FROM spans_index WHERE project_id = 1 AND $__timeFilter(time)) WHERE operation != '' GROUP BY bucket, operation ORDER BY bucket",
          "refId": "A"
        }
      ],
      "title": "Operation performance · p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "uptrace-clickhouse" },
      "description": "Application-observed PostgreSQL operations from OTel spans. Pool acquisition and transaction bookkeeping are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "ops/s",
