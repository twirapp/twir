      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "uptrace-clickhouse" },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT bucket AS time, operation, sum(count_x100) / 100 / greatest($__interval_s, 1) AS rate FROM (SELECT toStartOfInterval(time, INTERVAL $__interval_s SECOND) AS bucket, count_x100, multiIf(upperUTF8(attrs.db_operation_name::String) = 'SELECT' OR name IN ('gorm.Query', 'gorm.Row') OR positionCaseInsensitive(name, 'SELECT') > 0, 'Reads', upperUTF8(attrs.db_operation_name::String) IN ('INSERT', 'UPDATE', 'DELETE') OR positionCaseInsensitive(name, 'INSERT') > 0 OR positionCaseInsensitive(name, 'UPDATE') > 0 OR positionCaseInsensitive(name, 'DELETE') > 0, 'Writes', '') AS operation FROM spans_index WHERE project_id = 1 AND $__timeFilter(time) AND system = 'db:postgresql') WHERE operation != '' GROUP BY bucket, operation ORDER BY bucket",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL · read/write",
      "type": "timeseries"
    },
